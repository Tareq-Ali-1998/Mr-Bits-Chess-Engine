+// ############################################################
+// [worker] "Kernel.exe --worker": one JSON request per line on stdin, one JSON answer per line on stdout.
+
+using OrderedJson = nlohmann::ordered_json;
+
+const int WORKER_PROTOCOL_VERSION = 1;
+const string WORKER_ENGINE_VERSION = "kernel-worker-prototype-2026-10-25";
+
+double RoundToThreeDecimals(const double& value) {
+    return round(value * 1000.0) / 1000.0;
+}
+
+// Guards the board indexing in convertMoveFromStandardToInt16_t against garbage input.
+bool IsWellFormedStandardMove(const string& move) {
+    if ((move.size() != 4) && (move.size() != 5)) {
+        return false;
+    }
+    if ((move[0] < 'a') || (move[0] > 'h') || (move[2] < 'a') || (move[2] > 'h') ||
+        (move[1] < '1') || (move[1] > '8') || (move[3] < '1') || (move[3] > '8')) {
+        return false;
+    }
+    return (move.size() == 4) || (string("qrbn").find(move[4]) != string::npos);
+}
+
+vector<string> ReadMovesField(const OrderedJson& request, const string& key) {
+    vector<string> moves = request.at(key).get<vector<string>>();
+    for (const string& move : moves) {
+        if (!IsWellFormedStandardMove(move)) {
+            throw invalid_argument("\"" + key + "\" holds a malformed move: \"" + move + "\"");
+        }
+    }
+    return moves;
+}
+
+bool ReadEngineColorField(const OrderedJson& value) {
+    if (value.is_boolean()) {
+        return value.get<bool>();
+    }
+    if (value.is_number_integer()) {
+        return value.get<long long>() != 0;
+    }
+    throw invalid_argument("\"engineColor\" must be true/false (or 1/0)");
+}
+
+OrderedJson AnswerSearchRequest(const OrderedJson& request) {
+
+    const auto setupStart = chrono::high_resolution_clock::now();
+
+    const bool engineColor = ReadEngineColorField(request.at("engineColor"));
+    const vector<string> moves = ReadMovesField(request, "moves");
+    const vector<string> rootMoves = ReadMovesField(request, "rootMoves");
+    const int maxDepth = request.value("maxDepth", 0);
+    const int timeMs = request.value("timeMs", 0);
+    if ((maxDepth < 0) || (maxDepth > 30)) {
+        throw invalid_argument("\"maxDepth\" must be 0 (use timeMs) or 2..30");
+    }
+    if ((maxDepth == 0) && (timeMs <= 0)) {
+        throw invalid_argument("\"timeMs\" must be > 0 when \"maxDepth\" is 0");
+    }
+
+    ResetGameState(engineColor);
+    processHandler.setAllowedTimeInMilliSeconds(timeMs);
+    ReplayMoves(moves);
+    const double setupMs = MillisecondsSince(setupStart);
+
+    const auto searchStart = chrono::high_resolution_clock::now();
+    SearchOutcome outcome = RunIterativeDeepening(rootMoves, maxDepth, true);
+    const double searchMs = MillisecondsSince(searchStart);
+
+    const ProcessHandler& result = outcome.theFinalCompletedProcessHandler;
+    const bool ok = (!rootMoves.empty()) && outcome.completedAtLeastOneDepth;
+
+    OrderedJson answer;
+    answer["type"] = "result";
+    answer["id"] = request.contains("id") ? request["id"] : OrderedJson(nullptr);
+    answer["status"] = rootMoves.empty() ? "no_moves" : (ok ? "ok" : "no_completed_depth");
+    if (ok) {
+        answer["bestMove"] = result.getEngineBestMoveAsStandard();
+        answer["score"] = result.getBestEngineMoveScore();
+        answer["depth"] = (int)result.getEngineDepth();
+    }
+    else {
+        // File mode answers "a8a8" with score 0 here (the null move 0 printed as a square pair).
+        answer["bestMove"] = nullptr;
+        answer["score"] = nullptr;
+        answer["depth"] = 0;
+    }
+    answer["searchMs"] = RoundToThreeDecimals(searchMs);
+    answer["setupMs"] = RoundToThreeDecimals(setupMs);
+    // The last completed depth's main search, the same numbers as the old text report.
+    answer["nodes"] = ok ? result.getTheNumberOfAllTheInnerAndFinalStatesAs64Bit() : 0;
+    answer["leafNodes"] = ok ? result.getTheNumberOfAllTheFinalStates() : 0;
+    answer["pruned"] = ok ? result.getTheNumberOfAllTheBrunedBranchesAs64Bit() : 0;
+
+    long long totalNodes = 0;
+    OrderedJson perDepth = OrderedJson::array();
+    for (const IterationSummary& iteration : outcome.perDepth) {
+        totalNodes += iteration.nodes;
+        OrderedJson entry;
+        entry["depth"] = iteration.depth;
+        entry["completed"] = iteration.completed;
+        entry["ms"] = RoundToThreeDecimals(iteration.ms);
+        entry["nodes"] = iteration.nodes;
+        entry["leafNodes"] = iteration.leafNodes;
+        entry["pruned"] = iteration.pruned;
+        if (iteration.completed) {
+            entry["bestMove"] = processHandler.convertMoveFromInt16_tToStandard(iteration.bestMove);
+            entry["score"] = iteration.score;
+        }
+        entry["statesByRemainingDepth"] = iteration.statesByRemainingDepth;
+        entry["prunedByRemainingDepth"] = iteration.prunedByRemainingDepth;
+        perDepth.push_back(entry);
+    }
+    answer["totalNodes"] = totalNodes;   // every iteration, including an aborted last one
+    answer["perDepth"] = perDepth;
+
+    OrderedJson rootScores = OrderedJson::array();
+    set<string> searchedRootMoves;
+    for (const RootMoveScore& rootMoveScore : outcome.rootScoresOfTheFinalDepth) {
+        const string move = processHandler.convertMoveFromInt16_tToStandard(rootMoveScore.move);
+        searchedRootMoves.insert(move);
+        OrderedJson entry;
+        entry["move"] = move;
+        entry["score"] = rootMoveScore.score;
+        entry["exact"] = rootMoveScore.exact;
+        rootScores.push_back(entry);
+    }
+    answer["rootScores"] = rootScores;
+    // From depth 6 on, the root keeps only its 4 best moves (GetBestMoveAndItsScoreToInitializeProcessHandler).
+    OrderedJson unsearchedRootMoves = OrderedJson::array();
+    if (ok) {
+        for (const string& move : rootMoves) {
+            if (!searchedRootMoves.count(move)) {
+                unsearchedRootMoves.push_back(move);
+            }
+        }
+    }
+    if (!unsearchedRootMoves.empty()) {
+        answer["unsearchedRootMoves"] = unsearchedRootMoves;
+    }
+
+    return answer;
+}
+
+// The only writer of stdout in worker mode. It uses this executable's own C runtime, the same one as the
+// _setmode below: libstdc++-6.dll may be a build linked against another C runtime (Git Bash puts Git's
+// msvcrt-based MinGW first on PATH), and then cout would ignore the _setmode and send "\r\n".
+void WriteProtocolLine(const string& line) {
+    fwrite(line.data(), 1, line.size(), stdout);
+    fputc('\n', stdout);
+    fflush(stdout);
+}
+
+int RunWorkerMode() {
+
+    // stdout carries protocol lines only: from here on, anything else written to cout goes to stderr.
+    streambuf* const originalCoutBuffer = cout.rdbuf(cerr.rdbuf());
+    // Exactly "JSON\n" on the wire (text mode would send "\r\n"); a "\r" sent by the other side is stripped.
+    _setmode(_fileno(stdout), _O_BINARY);
+    _setmode(_fileno(stdin), _O_BINARY);
+
+    const auto initStart = chrono::high_resolution_clock::now();
+    BuildTheTablesOnce();
+    const double initMs = MillisecondsSince(initStart);
+
+    string line;
+    while (getline(cin, line)) {
+
+        if ((!line.empty()) && (line.back() == '\r')) {
+            line.pop_back();
+        }
+        if (line.find_first_not_of(" \t") == string::npos) {
+            continue;
+        }
+
+        OrderedJson answer;
+        OrderedJson id = nullptr;
+        bool quit = false;
+        try {
+            OrderedJson request = OrderedJson::parse(line);
+            if (!request.is_object()) {
+                throw invalid_argument("a request must be a JSON object");
+            }
+            if (request.contains("id")) {
+                id = request["id"];
+            }
+            const string type = request.at("type").get<string>();
+            if (type == "search") {
+                answer = AnswerSearchRequest(request);
+            }
+            else if (type == "hello") {
+                answer["type"] = "ready";
+                answer["protocol"] = WORKER_PROTOCOL_VERSION;
+                answer["engineVersion"] = WORKER_ENGINE_VERSION;
+                answer["pid"] = (long long)GetCurrentProcessId();
+                answer["initMs"] = RoundToThreeDecimals(initMs);
+            }
+            else if (type == "quit") {
+                quit = true;
+            }
+            else {
+                throw invalid_argument("unknown request type \"" + type + "\"");
+            }
+        }
+        catch (const exception& error) {
+            answer = OrderedJson::object();
+            answer["type"] = "error";
+            answer["id"] = id;
+            answer["message"] = error.what();
+        }
+
+        if (quit) {
+            break;
+        }
+        // "replace": an invalid UTF-8 byte echoed in an error message must not throw here.
+        WriteProtocolLine(answer.dump(-1, ' ', false, OrderedJson::error_handler_t::replace));
+    }
+
+    cout.rdbuf(originalCoutBuffer);
+    return 0;
+}
+
+int main(int argc, char* argv[]) {
+
+    // Set the priority of the parent process (The current process)
+    SetPriorityClass(GetCurrentProcess(), HIGH_PRIORITY_CLASS);
+
+    if ((argc >= 2) && (string(argv[1]) == "--worker")) {
+        return RunWorkerMode();
+    }
+
+    if (argc < 2) {
+        cout << "Insufficient argument provided." << endl;
+        return 1;
+    }
+
+    return RunFileMode(argv[1]);
+}
